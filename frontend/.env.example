# Frontend environment.
# Only VITE_-prefixed variables are exposed to the browser; values are baked
# in at BUILD time (run `npm run build` after editing).

# Base origin of the backend API. Leave empty to call /api on the same origin
# (the Vite dev proxy in dev, or a backend that also serves this built app).
# Example: VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=