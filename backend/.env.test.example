# Test environment overrides.
#
# Copy to .env.test and fill in a Neon BRANCH connection string -- never point
# tests at the same database the app uses. The suites create and delete real
# rows, and an interrupted run leaves orphans behind.
#
# Create a branch in the Neon console (or: neon branches create), then take its
# pooled and direct URLs and paste them below.
#
# A branch is created as a copy of its parent's schema AND data at the moment it
# is created, so if you create it now it should already contain all seven
# migrations and the demo seed. Verify rather than assume:
#
#   $env:DOTENV_CONFIG_PATH=".env.test"; npx tsx -e "import('pg').then(async ({default:pg})=>{const c=new pg.Client({connectionString:process.env.DATABASE_URL});await c.connect();console.log((await c.query('SELECT name FROM schema_migrations ORDER BY name')).rows.map(r=>r.name));await c.end()})"
#
# If you ever DO need to migrate the branch, do not run `npm run migrate` plainly:
# migrate.ts loads .env through dotenv/config, so that command would apply
# migrations to the application database and leave the branch untouched.
# Point dotenv at .env.test for the duration of the command:
#
#   $env:DOTENV_CONFIG_PATH=".env.test"; npx tsx src/config/migrate.ts
#
# BCRYPT_COST is set here rather than in .env because the suite performs 60+
# hashes and compares; cost 12 would add ~13s of pure CPU for no extra
# coverage. The test environment must never reach production.
NODE_ENV=test
BCRYPT_COST=4

DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

JWT_SECRET=test-only-not-a-real-secret-at-least-32-chars
GROQ_API_KEY=test-only-placeholder

AI_MODEL=openai/gpt-oss-120b
DEFAULT_BUSINESS_ID=00000000-0000-0000-0000-000000000001
PORT=4001
