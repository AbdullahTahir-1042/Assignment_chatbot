# Validated by backend/src/config/env.ts at boot -- the process exits if any
# of these is missing or malformed. Copy to backend/.env and fill in.

NODE_ENV=development
PORT=4000

# --- App (pooled: PgBouncer, transaction mode) ---
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXX-YYY-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full

# --- Migrations only (direct: no PgBouncer) ---
# Read solely by `npm run migrate` and `npm run seed`; env.ts does not require it.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-XXX-YYY.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Must be >= 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

GROQ_API_KEY=

# openai/gpt-oss-120b is the current free-tier default and supports strict JSON
# output. Note that llama-3.3-70b-versatile was retired by Groq in Aug 2026 and
# is Enterprise-only, so it fails on a self-serve key.
AI_MODEL=openai/gpt-oss-120b

# Business assigned to new signups, since the schema is multi-tenant.
# Matches the id seeded in backend/db/seed.sql.
DEFAULT_BUSINESS_ID=00000000-0000-0000-0000-000000000001

# Origin allowed by CORS. In dev the Vite proxy makes requests same-origin,
# but this still needs to match for direct calls.
CORS_ORIGIN=http://localhost:5173
